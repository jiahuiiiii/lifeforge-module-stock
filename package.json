{
  "name": "@lifeforge/jiahuiiiii--stock",
  "displayName": "Stock",
  "version": "0.0.4",
  "type": "module",
  "description": "Track stocks, manage your watchlist, build virtual portfolio, and analyze stocks with the Cold Eye Investment Strategy.",
  "author": "jiahuiiiii <wongjiahui0915@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jiahuiiiii/lifeforge-module-stock"
  },
  "scripts": {
    "typecheck": "pnpm run typecheck:client && pnpm run typecheck:server",
    "typecheck:client": "cd client && tsc",
    "typecheck:server": "cd server && tsc",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "cd client && vite build",
    "build:server": "cd server && vite build"
  },
  "dependencies": {
    "katex": "^0.16.27",
    "recharts": "^2.15.0"
  },
  "lifeforge": {
    "category": "Finance",
    "icon": "material-symbols-light:candlestick-chart",
    "APIKeyAccess": {
      "fmp": {
        "required": true,
        "usage": "Fetching stock quotes"
      }
    }
  },
  "peerDependencies": {
    "@lifeforge/api": "workspace:*",
    "@lifeforge/configs": "workspace:*",
    "@lifeforge/drizzle": "workspace:*",
    "@lifeforge/federation": "workspace:*",
    "@lifeforge/file-storage": "workspace:*",
    "@lifeforge/localization": "workspace:*",
    "@lifeforge/server-utils": "workspace:*",
    "@lifeforge/ui": "workspace:*"
  }
}
